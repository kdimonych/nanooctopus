{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "rust: cargo build"
		},
		{
			"type": "shell",
			"label": "build: rasberry_pico_w (thumbv6m)",
			"command": "cargo",
			"args": [
				"build_rasberry_pico_w",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"type": "shell",
			"label": "run: rasberry_pico_w (thumbv6m)",
			"command": "cargo",
			"args": [
				"run_rasberry_pico_w",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		}
	]
}
